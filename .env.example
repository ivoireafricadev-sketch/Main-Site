# Copy to .env for local `npx netlify dev`, and set the same values in
# Netlify: Site configuration > Environment variables.
#
# .env is gitignored. Never commit real values.

# Airtable personal access token.
# Create at https://airtable.com/create/tokens with ONLY:
#   scope  : data.records:write
#   access : the single Ivoire leads base
AIRTABLE_TOKEN=

# Base ID - the "appXXXXXXXXXXXXXX" segment of your Airtable base URL.
AIRTABLE_BASE_ID=

# Optional. Defaults are "Group Leads" and "MRO Leads"; set these only if the
# tables get renamed in Airtable.
AIRTABLE_TABLE_GROUP=
AIRTABLE_TABLE_MRO=
