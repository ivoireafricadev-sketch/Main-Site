# Copy to .env for local testing, and set the same values in Netlify under
# Site configuration > Environment variables.
#
# .env is gitignored. Never commit real values.

# ---------------------------------------------------------------- EMAIL
# Required. Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Who receives each form. Comma-separate for more than one recipient.
LEAD_EMAIL_TO_GROUP=info@ivoireafrica.com
LEAD_EMAIL_TO_MRO=info@ivoireafrica.com

# Optional. Leave BLANK until ivoireafrica.com is verified in Resend - the
# code falls back to Resend's shared test sender so everything works before
# DNS is sorted. After verifying the domain, set this to:
#   Ivoire Enquiries <enquiries@ivoireafrica.com>
LEAD_EMAIL_FROM=

# ------------------------------------------------------------- AIRTABLE
# Entirely optional. Leave every value blank and the function simply skips
# the Airtable step; email still works. Fill these in only if the client
# wants a browsable database of leads on top of the notification emails.
#
# Token: https://airtable.com/create/tokens
#   scope  : data.records:write
#   access : the single Ivoire leads base
AIRTABLE_TOKEN=

# The "appXXXXXXXXXXXXXX" segment of the Airtable base URL.
AIRTABLE_BASE_ID=

# Only needed if the tables are named something other than the defaults
# ("Group Leads" and "MRO Leads").
AIRTABLE_TABLE_GROUP=
AIRTABLE_TABLE_MRO=
